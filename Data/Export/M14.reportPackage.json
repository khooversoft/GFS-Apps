":"1"},{"key":"sql-m14.101.descr","value":"delete from TransX where KeyID = '[batchID]'  and '[version]' = 'B' and GL > '3000000'"},{"key":"sql-m14.102.descr","value":"delete from TransX where  KeyID =  '[batchID]'  and substring('[BudAct]',1,7) = 'IF-ODY ' and (Co not in ('5990','5991','5992','5993','5994','5995','5996') and Co not between '1000' and '5000')"},{"key":"sql-m14.103.descr","value":"delete from TransX where  KeyID =  '[batchID]' and substring('[BudAct]',1,7) = 'LG-CAD ' and Co not in ('2006','9006')"},{"key":"sql-m14.104.descr","value":"delete from TransX where  KeyID =  '[batchID]'  and substring('[BudAct]',1,7) = 'LS-SING' and Co not in ('2004','2005','9005')"},{"key":"sql-m14.105.descr","value":"delete from TransX where  KeyID =  '[batchID]' and substring('[BudAct]',1,7) = 'LG-HUDC' and Co not in ('2310','9231')"},{"key":"sql-m14.106.descr","value":"delete from TransX where KeyID = '[batchID]'  and GL = '2880000' and not TTY = '803'"},{"key":"sql-m14.107.descr","value":"delete from TransX where KeyID = '[batchID]'  and GL in ('1550000','1560000','2150000','2160000','2851017','2868901','4430000')"},{"key":"sql-m14.108.descr","value":"delete from TransX where KeyID = '[batchID]'  and GL in ('2853500','2880000')"},{"key":"sql-m14.111.descr","value":"Update TransX set BusCat = 'C' where KeyID = '[batchID]' and BusCat like '3%'"},{"key":"sql-m14.112.descr","value":"Update TransX set BusCat = 'D' where KeyID = '[batchID]' and BusCat = '10'"},{"key":"sql-m14.113.descr","value":"Update TransX set BusCat = 'A' where KeyID = '[batchID]' and BusCat like '2%'"},{"key":"sql-m14.114.descr","value":"Update TransX set BusCat = 'C' where KeyID = '[batchID]' and (substring(GL,1,2) in ('14','15','23') or GL like '287%') and not BusCat in ('A','D','C')"},{"key":"sql-m14.115.descr","value":"Update TransX set BusCat = 'A' where KeyID = '[batchID]' and (GL like '6%' or GL = '4498000')"},{"key":"sql-m14.119.descr","value":"Update TransX set BusCat = 'A' where KeyID = '[batchID]' and not BusCat in ('A','D','C')"},{"key":"sql-m14.131.descr","value":"Update TransX set Flex1 = (case when Co like '599%' or Co like '9%' then 'IFRS-17' else 'IFRS-4' end) where KeyID = '[batchID]'"},{"key":"sql-m14.132.descr","value":"Update TransX set Amt1 = Amt2 where KeyID = '[batchID]' and '[version]' = 'B' and Flex1 = 'IFRS-4'"},{"key":"sql-m14.133.descr","value":"Update TransX set Amt1 = Amt1 + Amt2 where KeyID = '[batchID]' and '[version]' <> 'B'"},{"key":"sql-m14.211.descr","value":"insert into TransX (KeyID, Flex1, Co, GL, BusCat, Amt1,Flex2) (select KeyID, Flex1, Co, GL, BusCat, round(sum(Amt1),2), 'pass1' as Flex2 from TransX where KeyID = '[batchID]'  group by KeyID, Flex1, Co, GL, BusCat)"},{"key":"sql-m14.212.descr","value":"delete from TransX where KeyID = '[batchID]'  and Flex2 is NULL"},{"key":"sql-m14.213.descr","value":"delete from TransX where KeyID = '[batchID]'  and Amt1 = 0"},{"key":"sql-m14.312.descr","value":"update x set GLdesc = c.Name from TransX x inner join COA c on x.GL = c.GL where KeyID = '[batchID]'"},{"key":"sql-m14.711.descr","value":"insert into TransX (KeyID,Yr,Flex1) (select '[batchID]-data3',Field1,Descr from Misc_Tables where Table_ID = 'Review Notes' and ID = 'M14')"},{"key":"sqlselect.m14.descr","value":"insert into TransX (KeyID, Co, GL, BusCat, Amt2,Amt1) values ('[batchID]',"}]}