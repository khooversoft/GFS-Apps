ommand","description":"Import from V1","sqlCommand":"update TransX set GL = m.Descr, GLdesc = c.Descr from TransX t inner join Misc_Tables m on GL = ID inner join COA c on t.GL = c.GL where Table_ID = 'ElimGLmap3' and KeyID = '[batchID]'  and Co <> '2008'","hash":"067828142BD59F01C713AF658146B0ED"},{"$type":"SqlCommandActivity","id":"505","type":"SQL Command","description":"Import from V1","sqlCommand":"update TransX set GL = substring(GL,1,3) + '9901' from TransX where KeyID = '[batchID]' and GL like '%9900' and substring(gl,1,3) <> '533'","hash":"D13E673975D9D9557B2F61D91AC93733"},{"$type":"SqlCommandActivity","id":"508","type":"SQL Command","description":"Import from V1","sqlCommand":"insert into TransX (KeyID, Ledger, GL, UWYR, Amt1, Flex1) (Select KeyID, Ledger,GL, UWYR, round(sum(Amt1),2) as Amt1, 'pass4' as Flex1 from TransX where KeyID = '[batchID]' and GL > '4000000' group by KeyID, Ledger, GL, UWYR)","hash":"A88AE864A27F46DE7E7C96ACF8CF17EC"},{"$type":"SqlCommandActivity","id":"509","type":"SQL Command","description":"Import from V1","sqlCommand":"delete from TransX where KeyID = '[batchID]' and (Flex1 is NULL or Amt1 = 0)","hash":"5C51D98B872E66AC3A74BE5D6E82163A"},{"$type":"SqlCommandActivity","id":"510","type":"SQL Command","description":"Import from V1","sqlCommand":"update TransX set Amt2 = f2.Amt1 from TransX f1 inner join (Select KeyID, Ledger, GL, UWYR, Amt1 from TransX where KeyID = '[batchID]' and Ledger = 'IF') f2 on f1.KeyID = f2.KeyID and f1.GL = f2.GL and f1.UWYR = f2.UWYR and f1.Amt1 = f2.Amt1","hash":"5F65F39E1757EEF86551EF5C04DB181E"},{"$type":"SqlCommandActivity","id":"511","type":"SQL Command","description":"Import from V1","sqlCommand":"update TransX set Amt3 = f2.Amt1 from TransX f1 inner join (Select KeyID, Ledger, GL, UWYR, Amt1 from TransX where KeyID = '[batchID]' and Ledger = 'UG') f2 on f1.KeyID = f2.KeyID and f1.GL = f2.GL and f1.UWYR = f2.UWYR and f1.Amt1 = f2.Amt1","hash":"7CA5ACBE3E53E91041F1CAD5B8A2CA70"},{"$type":"SqlCommandActivity","id":"513","type":"SQL Command","description":"Import from V1","sqlCommand":"update TransX set Ledger = 'Z000' from TransX where KeyID = '[batchID]' and Ledger = 'IF' and Amt1 = Amt3","hash":"C377DF45E0D82CC8A069DB85E684DD32"},{"$type":"SqlCommandActivity","id":"514","type":"SQL Command","description":"Import from V1","sqlCommand":"delete from TransX where KeyID = '[batchID]' and Ledger = 'UG' and Amt1 = Amt2","hash":"6C6F753CB17B4EBEE55CEBCF46E1F22A"},{"$type":"SqlCommandActivity","id":"530","type":"SQL Command","description":"Import from V1","sqlCommand":"update TransX set GLdesc = c.Descr from TransX t inner join COA c on t.GL = c.GL where KeyID = '[batchID]'","hash":"6F1A574D32A9AEBC1B4428EAB24CC7FB"},{"$type":"SqlCommandActivity","id":"540","type":"SQL Command","description":"Import from V1","sqlCommand":"update TransX set PC = '1406000310', Contract = 'OACN16600', TP = '3030', Co = '2008', BusCat = '24', CC = '', TTY = '' from TransX where KeyID = '[batchID]'","hash":"E683664D1FB768D8CFE65CC1FD41E3FE"},{"$type":"SqlCommandActivity","id":"545","type":"SQL Command","description":"Import from V1","sqlCommand":"delete from TransX where KeyID = '[batchID]' and contract = 'OACN16600' and gl = '5339901'","hash":"36A2808F2AF4A41CE843CD3366552BB5"},{"$type":"SqlCommandActivity","id":"546","type":"SQL Command","description":"Import from V1","sqlCommand":"update t set UWYR = s.UWYR from TransX t join CorpAcct_Apps.dbo.SAP_Ledger_Data s on t.co = s.co and t.pc = s.profit_centre and t.tp = s.trade_ptr and t.contract = s.contract and t.gl = s.gl and t.buscat = s.bus_cat where KeyID = '[batchID]' and t.UWYR = ''","hash":"0376F559CE547D1928A687CC78B4C7FF"}]}