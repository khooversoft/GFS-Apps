<MudDrawerHeader>
    <MudStack>
        @if (Title.IsNotEmpty())
        {
            <MudText Typo="Typo.h6">@Title</MudText>
        }

        @ChildContent
    </MudStack>

</MudDrawerHeader>

@code {
    [Parameter] public RenderFragment ChildContent { get; set; } = null!;
    [Parameter] public string? Title { get; set; }
}
