<MudDrawer Open="@Open" OpenChanged=@OnClose Anchor="Anchor.End" Elevation="1" Variant="@DrawerVariant.Temporary" OverlayAutoClose=true Width="60%">
    <MudDrawerHeader>
        <MudText Typo="Typo.h6">@GetTitle()</MudText>
    </MudDrawerHeader>
    <MudDrawerContainer>
        <MudStack Spacing="2" Style="margin:10px">
            <Toolbar>
                <ToolbarButton Variant="ToolbarVariant.Upload" OnClick="@OnUpload" Disabled="@GetUploadDisable()" />
                <ToolbarButton Variant="ToolbarVariant.Clear" OnClick="@OnClear" Disabled="@GetUploadDisable()" />
                <ToolbarButton Variant="ToolbarVariant.Close" OnClick="@OnClose" />
            </Toolbar>

            <MudCard Elevation="2">
                <MudCardHeader>
                    <MudStack Row="true" Style="width:100%" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h6">Drag and Drop</MudText>
                        <MudSpacer />

                        <div style="width:200px">
                            <MudFileUpload @bind-Files="@_files"
                                           @bind-Files:after="StateHasChanged"
                                           DragAndDrop="true"
                                           AppendMultipleFiles="true"
                                           Disabled="@_uploading">
                                <CustomContent>
                                    <MudButton Variant="Variant.Filled"
                                               OnClick="@context.OpenFilePickerAsync"
                                               Color="Color.Info">
                                        Browse local computer
                                    </MudButton>
                                </CustomContent>
                                <SelectedTemplate />
                            </MudFileUpload>
                        </div>
                    </MudStack>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack Spacing="2">
                        <MudFileUpload @bind-Files="@_files"
                                       @bind-Files:after="StateHasChanged"
                                       DragAndDrop="true"
                                       AppendMultipleFiles="true"
                                       Disabled="@_uploading">
                            <SelectedTemplate />
                        </MudFileUpload>

                        <MudCheckBox @bind-Value="_overwriteFile" Label="Overwrite existing files" LabelPlacement="Placement.Right" />
                    </MudStack>
                </MudCardContent>
            </MudCard>

            @if (_uploading)
            {
                <MudProgressLinear Color="Color.Primary" Value=@GetCurrentUploadCount()" Class="my-7" />
            }

            <MudDataGrid T="IBrowserFile"
                         Items="@_files"
                         ReadOnly="true"
                         Dense="true"
                         Bordered="true">
                <Columns>
                    <TemplateColumn CellStyle="width: 1%; white-space: nowrap;" HeaderStyle="width: 1%; white-space: nowrap;">
                        <CellTemplate>
                            @switch (_uploading)
                            {
                                case true:
                                    if (_uploadedList.TryGetValue(context.Item.Name, out var fileAction))
                                    {
                                        if (fileAction.Success)
                                        {
                                            <MudIcon Color="Color.Success" Size="@Size.Small" Icon="@Icons.Material.Outlined.CheckCircle" />
                                        }
                                        else
                                        {
                                            <MudIcon Color="Color.Error" Size="@Size.Small" Icon="@Icons.Material.Outlined.Error" />
                                        }
                                    }
                                    else
                                    {
                                        <MudIcon Color="Color.Default" Size="@Size.Small" Icon="@Icons.Material.Outlined.HourglassEmpty" />
                                    }

                                    break;
                                case false:
                                    <MudIconButton Color="Color.Error" Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => DeleteItem(context.Item))" />
                                    break;
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.Name" Title="Name" />
                    <PropertyColumn Property="x => x.GetSizeK()" Title="Size" CellStyle="width: 1%; white-space: nowrap;" HeaderStyle="width: 1%; white-space: nowrap;" />
                </Columns>
            </MudDataGrid>

        </MudStack>
    </MudDrawerContainer>
    <MudDivider />
</MudDrawer>

@code {
    @inject SharedFileStore _sharedFileStore;

    [Parameter] public bool Open { get; set; }
    [Parameter] public string Description { get; set; } = null!;
    [Parameter] public string BasePath { get; set; } = null!;
    [Parameter] public EventCallback OnClose { get; set; }

    private IReadOnlyList<IBrowserFile> _files = [];
    private bool _overwriteFile = false;
    private string GetTitle() => Description is not null ? Description : "Upload File";

    private record FileAction(string File, bool Success, string? ErrorMessage = null);
    private bool _uploading = false;
    private ConcurrentDictionary<string, FileAction> _uploadedList = new(StringComparer.OrdinalIgnoreCase);
    private int GetCurrentUploadCount() => _uploadedList.Count - (_uploadedList.Count - _uploadedList.Count);
    private bool GetUploadDisable() => _files.Count == 0 || _uploading;

    private async Task OnUpload()
    {
        if (_files.Count == 0) return;

        _uploadedList.Clear();
        _uploading = true;

        foreach (var file in _files)
        {
            string path = $"{BasePath}/{file.Name}";
            Stream readStream = file.OpenReadStream();
            DataETag dataETag = readStream.ToDataETag();

            var option = _overwriteFile switch
            {
                false => await _sharedFileStore.Add(path, dataETag),
                true => await _sharedFileStore.Upsert(path, dataETag)
            };

            if (option.IsError())
            {
                _uploadedList[file.Name] = new FileAction(file.Name, false, "File already exists");
                continue;
            }

            _uploadedList[file.Name] = new FileAction(file.Name, true, "File up loaded");
        }
    }

    private void OnClear()
    {
        _files = [];
        StateHasChanged();
    }

    private void DeleteItem(IBrowserFile file)
    {
        _files = _files.Where(f => f != file).ToList();
    }
}