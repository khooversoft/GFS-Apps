<MudStack Spacing="2" Row="true">
    <MudPaper Elevation="2" Style="@GetStyle()">
        <MudStack Spacing="2">
            <MudIconButton Icon="@(_navMenuCollapsed ? Icons.Material.Outlined.ChevronRight : Icons.Material.Outlined.ChevronLeft)"
                           Color="Color.Default"
                           Size="Size.Small"
                           Style="align-self:flex-end"
                           OnClick="() => _navMenuCollapsed = !_navMenuCollapsed" />

            <MudNavMenu Dense="true">
                @foreach (var item in Items)
                {
                    <MudTooltip Text="@item.Text" Placement="Placement.Right" Disabled="@(!_navMenuCollapsed)">
                        <MudNavLink Icon="@item.Icon" OnClick="@item.OnClick" Match="NavLinkMatch.Prefix">@(_navMenuCollapsed ? string.Empty : @item.Text)</MudNavLink>
                    </MudTooltip>
                }
            </MudNavMenu>
        </MudStack>
    </MudPaper>
    <MudPaper Elevation="2" Style="flex:1 1 auto; min-width:0">
        <div style="margin-bottom: 5px; padding:10px; width:100%; box-sizing:border-box">
            @ChildContent
        </div>
    </MudPaper>
</MudStack>


@code {
    [Parameter] public RenderFragment ChildContent { get; set; } = null!;
    [Parameter] public bool Expand { get; set; } = false;
    [Parameter] public IReadOnlyList<NavMenuItem> Items { get; set; } = [];
    [Parameter] public string MaxWidth { get; set; } = "150px";

    private bool _navMenuCollapsed = false;
    private string GetStyle() => _navMenuCollapsed ? Fixup("55px") : Fixup(MaxWidth);
    private string Fixup(string value) => $"flex:0 0 {value};width:{value};max-width:{value};min-width:{value};box-sizing:border-box;overflow:hidden";
}
