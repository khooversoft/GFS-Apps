<MudPaper Elevation="@Elevation" Square="true" Style="@PaperStyle">
    <MudToolBar Dense=true Gutters=false Style="@Style">

        @ChildContent

    </MudToolBar>
</MudPaper>

@code {
    [Parameter] public RenderFragment ChildContent { get; set; } = null!;
    [Parameter] public int Elevation { get; set; } = 2;
    [Parameter] public bool NoLine { get; set; }
    [Parameter] public string? Style { get; set; }

    private string PaperStyle => NoLine ? string.Empty : "border-bottom-color:gray;border-bottom-style:solid;border-bottom-width:1px";
    private string ToolBarStyle => string.Empty; // "min-height:32px;height:32px;";
}
