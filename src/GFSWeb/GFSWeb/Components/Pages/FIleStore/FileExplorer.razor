@using System.Collections.Frozen
<MudStack Spacing="2">
    @if (!_initialized)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Rounded="true" Size="Size.Medium" Value="100" Style="margin:20px" />
    }
    else
    {
        <PathNavigation Path="@Path" SkipSegments="1" OnClick="@OnPathChanged" />

        <MudDataGrid T="StorePathDetail"
                     Items="@_elements"
                     ReadOnly="true"
                     Dense="true"
                     SelectOnRowClick="true"
                     SelectedItems="@_selectedItems"
                     MultiSelection="@MultiSelect"
                     SelectedItemsChanged="@HandleMultiSelect"
                     Bordered="true"
                     QuickFilter="QuickFilter"
                     Filterable="true">
            <Columns>
                <SelectColumn T="StorePathDetail" />
                <TemplateColumn Title="File Name" Sortable="true" SortBy="@(x => x.GetFileName())">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            @if (context.Item.IsFolder)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Folder" Color="Color.Warning" />

                                <MudLink Color="Color.Info"
                                         OnClick="@(() => OnPathChanged.InvokeAsync(context.Item.Path))"
                                         Style="cursor: pointer;">
                                    @context.Item.GetFileName()
                                </MudLink>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Default" />

                                <MudLink Color="Color.Info"
                                         OnClick="@(() => ViewItem(context.Item))"
                                         Style="cursor: pointer;">
                                    @context.Item.GetFileName()
                                </MudLink>
                            }

                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.LastModified" Title="Last Modified" CellStyle="width: 1%; white-space: nowrap;" HeaderStyle="width: 1%; white-space: nowrap;" Sortable="true" />
                <PropertyColumn Property="x => x.SizeK" Title="Size" CellStyle="width: 1%; white-space: nowrap;" HeaderStyle="width: 1%; white-space: nowrap;" Sortable="true" />
            </Columns>
        </MudDataGrid>
    }
</MudStack>

@code {
    @inject SharedFileStore _sharedFileStore;
    @inject ISnackbar _snackbar;
    @inject IJSRuntime JSRuntime;

    [Parameter] public string Path { get; set; } = null!;
    [Parameter] public string? Search { get; set; }
    [Parameter] public bool MultiSelect { get; set; }
    [Parameter] public EventCallback<HashSet<StorePathDetail>> OnSelectedItemsChanged { get; set; }
    [Parameter] public EventCallback<string> OnPathChanged { get; set; }

    private bool _initialized = false;
    private string? _savePath;
    private bool _multiSelectSaveState;
    private IReadOnlyList<StorePathDetail> _elements = [];
    private HashSet<StorePathDetail> _selectedItems = [];

    protected override async Task OnParametersSetAsync()
    {
        if (_multiSelectSaveState != MultiSelect)
        {
            _multiSelectSaveState = MultiSelect;
            _selectedItems = [];
            await OnSelectedItemsChanged.InvokeAsync(_selectedItems);
        }

        if (_savePath != Path)
        {
            _savePath = Path;
            await Load();
        }
    }

    public Task RefreshAsync() => Load();

    private async Task HandleMultiSelect(HashSet<StorePathDetail> items)
    {
        _selectedItems = items;
        await OnSelectedItemsChanged.InvokeAsync(_selectedItems);
    }

    private async Task Load()
    {
        string path = Path + "/***";
        var searchList = await _sharedFileStore.Search(path, includeFolder: true);

        _elements = searchList
            .Where(IsInCurrentFolder)
            .ToArray();

        _initialized = true;
        StateHasChanged();
    }

    private bool IsInCurrentFolder(StorePathDetail item)
    {
        string currentPath = NormalizePath(Path);
        string itemPath = NormalizePath(item.Path);

        if (itemPath == currentPath) return false;

        string relativePath = currentPath.Length switch
        {
            0 => itemPath,
            _ when itemPath.StartsWith(currentPath + "/", StringComparison.OrdinalIgnoreCase) => itemPath[(currentPath.Length + 1)..],
            _ => string.Empty,
        };

        if (relativePath.IsEmpty()) return false;

        return !relativePath.Contains('/');
    }

    private static string NormalizePath(string path) => path.Trim('/');

    private bool QuickFilter(StorePathDetail item)
    {
        if (Search is null) return true;
        return item.Path.Contains(Search, StringComparison.OrdinalIgnoreCase);
    }

    private async Task ViewItem(StorePathDetail item)
    {
        item.NotNull().Path.NotEmpty();

        var fileResult = await _sharedFileStore.Get(item.Path);

        if (fileResult.IsError())
        {
            _snackbar.Add($"Can not find {item.Path}", Severity.Error);
            return;
        }

        byte[] fileData = fileResult.Return().Data.ToArray();
        var fileStream = new MemoryStream(fileData);
        using var streamRef = new DotNetStreamReference(stream: fileStream);

        string ext = System.IO.Path.GetExtension(item.Path);
        // string jsFunction = _viewableExtensions.Contains(ext) ? "openFileInBrowser" : "downloadFileFromStream";

        await JSRuntime.InvokeVoidAsync("openFileInBrowser", item.Path, streamRef);
    }
}