<MudDrawer Open="@Show"
           OpenChanged="@OnClose"
           Anchor="Anchor.End"
           Elevation="1"
           Variant="@DrawerVariant.Temporary"
           OverlayAutoClose=true
           Width="60%">

    <MudPaper Class="ma-2" Elevation="2" Style="padding:10px">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">File Properties</MudText>
        </MudDrawerHeader>
        <MudDrawerContainer>
            <MudStack Spacing="2">

                <MudSimpleTable Dense="true" Bordered="true" Outlined="true" Style="overflow-x: auto;" Elevation="0">
                    <tbody>
                        <tr>
                            <td style="white-space:nowrap;width:1%;">Path</td>
                            <td>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudTextField Value="@Path" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" />

                                    <MudTooltip Text="Copy path">
                                        <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy"
                                                       Size="Size.Small"
                                                       Color="Color.Info"
                                                       OnClick="@CopyPathToClipboard" />
                                    </MudTooltip>
                                </MudStack>
                            </td>
                        </tr>
                        <tr>
                            <td style="white-space:nowrap;width:1%;">Length</td>
                            <td>@_pathDetails?.SizeK</td>
                        </tr>
                        <tr>
                            <td style="white-space:nowrap;width:1%;">Last Updated</td>
                            <td>@_pathDetails?.LastModified.LocalDateTime.ToString("g")</td>
                        </tr>
                    </tbody>
                </MudSimpleTable>

                <MudButton Variant="Variant.Outlined" Color="Color.Surface" OnClick="@OnClose" Style="width:100px;margin:10px">Close</MudButton>
            </MudStack>
        </MudDrawerContainer>
    </MudPaper>
</MudDrawer>

@code {
    @inject SharedFileStore _sharedFileStore;
    @inject ISnackbar _snackbar;
    @inject IJSRuntime JSRuntime;

    [Parameter] public bool Show { get; set; }
    [Parameter] public string Path { get; set; } = null!;
    [Parameter] public EventCallback OnClose { get; set; }

    private string _savePath = null!;
    private StorePathDetail? _pathDetails;

    protected override async Task OnParametersSetAsync()
    {
        if (!Show) return;

        if (_savePath != Path)
        {
            _savePath = Path;

            var list = await _sharedFileStore.Search(Path, false);
            if (list.Count != 1)
            {
                await OnClose.InvokeAsync();
                return;
            }

            _pathDetails = list.First();
        }
    }

    private async Task CopyPathToClipboard()
    {
        if (string.IsNullOrWhiteSpace(Path)) return;

        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", Path);
        _snackbar.Add($"Copied {Path}", Severity.Info);
    }
}
