@page "/files/{storeType}/"
@page "/files/{storeType}/{*path}"
@using GFSWeb.Components.Controls.Toolbar

<MudStack Spacing="2">
    <ReturnUrlButton ReturnUrl=@returnUrl />
    <BlockHeader Title="@_title" />

    <Toolbar>
        <ToolbarButton Variant="ToolbarVariant.Delete" OnClick="@OnDelete" Disabled="@(_selectedItems.Count == 0)" />
        <ToolbarButton Variant="ToolbarVariant.Upload" OnClick="@OnUploadOpen" />
        <ToolbarButton Variant="ToolbarVariant.Download" OnClick="@OnDownload" Disabled="@(_selectedItems.Count == 0)" />
        <ToolbarButton Variant="ToolbarVariant.NewFolder" OnClick="@(() => _askNewFolder = true)" />
        <ToolbarButton Variant="ToolbarVariant.Refresh" OnClick="@OnRefresh" />
        <ToolbarButton Variant="ToolbarVariant.OpenInBrowser" OnClick="@OpenInBrowser" Disabled="@DisableOpenInBrowser()" />
        <ToolbarButton Variant="ToolbarVariant.List" OnClick="@OnProperties" Disabled="@(_selectedItems.Count != 1)" />
        <ToolbarSpacer />
        <ToolbarSwitch Label="Select" @bind-Value="_multiSelect" />
        <ToolbarSearch OnClick="@OnSearch" />
    </Toolbar>

    <FileExplorer @ref="_fileExplorer" Path="@_currentPath" OnSelectedItemsChanged="@OnSelectedItemsChanged" OnPathChanged="@OnPathChanged" Search="@_searchString" MultiSelect="@_multiSelect" />
</MudStack>

<Question Show="@_showDeleteQuestion" Title="Delete Confirmation" Descriptions="@_descriptions" OnYes="@(() => DeleteItem())" OnNo="@(() => _showDeleteQuestion = false)" />

<UploadFile Open="@_showUpload" Description="Upload file to current folder" OnClose="@OnUploadClose" BasePath="@_currentPath" />

<CreateFolderDrawer Show="@_askNewFolder" BasePath="@_currentPath" OnClose="@(() => _askNewFolder = false)" OnFolderCreated="@OnRefresh" />

<FilePropertyDrawer Show="@_showFileProperty" Path="@GetSelectedPath()" OnClose="@(() => _showFileProperty = false)" />

@code {
    @inject SharedFileStore _sharedFileStore;
    @inject IAuthAccess _authAccess;
    @inject ISnackbar _snackbar;
    @inject IJSRuntime JSRuntime;

    [Parameter] public string StoreType { get; set; } = null!;
    [Parameter] public string? Path { get; set; }
    [Parameter, SupplyParameterFromQuery] public string returnUrl { get; set; } = null!;

    private string _title = string.Empty;
    private bool _showDeleteQuestion;
    private bool _showUpload;
    private bool _showFileProperty = false;
    private bool _askNewFolder = false;
    private bool _multiSelect = false;
    private IReadOnlyList<string> _descriptions = [];
    private string? _searchString;

    private HashSet<StorePathDetail> _selectedItems = new();
    private readonly List<string> _paths = new();
    private string _storeType = string.Empty;
    private string _basePath = string.Empty;
    private string _currentPath = string.Empty;
    private FileExplorer _fileExplorer = null!;

    private void OnSelectedItemsChanged(HashSet<StorePathDetail> items) => _selectedItems = items;
    private void OnProperties() => _showFileProperty = _selectedItems.Count == 1;

    private string? GetSelectedPath() => _selectedItems.Count switch
    {
        1 => _selectedItems.First().Path,
        _ => null,
    };

    private async Task OnRefresh()
    {
        _askNewFolder = false;
        _showUpload = false;
        _showDeleteQuestion = false;
        _showFileProperty = false;

        await _fileExplorer.RefreshAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        _storeType = StoreType switch
        {
            var v when v.EqualsIgnoreCase(SharedFileStoreTool.SharedRootPath) => SharedFileStoreTool.SharedRootPath,
            var v when v.EqualsIgnoreCase(SharedFileStoreTool.PersonalRootPath) => SharedFileStoreTool.PersonalRootPath,
            _ => throw new Exception($"Unknown store type {StoreType}")

        };

        (_basePath, _title) = _storeType switch
        {
            SharedFileStoreTool.SharedRootPath => (SharedFileStoreTool.SharedRootPath, "Shared Files"),
            SharedFileStoreTool.PersonalRootPath => await setUser(),

            _ => throw new Exception($"Unknown store type {StoreType}")
        };

        _paths.Clear();
        _paths.AddRange([_storeType, _basePath, .. Path?.Split('/') ?? []]);
        _currentPath = _paths.Join('/');

        async Task<(string basePath, string title)> setUser()
        {
            var email = (await _authAccess.GetEmail()).NotEmpty("No email");
            var userName = (await _authAccess.GetUserName()).NotEmpty("No user name");
            return (email, "Personal files for " + userName);
        }
    }

    private void OnPathChanged(string path)
    {
        path.NotEmpty();
        var elements = path.Split('/').ToArray();
        elements.Length.Assert(x => x > 1, "Path should have at least 2 elements");
        elements[0].Assert(x => x == _storeType, $"Store type does not match {_storeType}");
        elements[1].Assert(x => x == _basePath, $"Base path does not match {_basePath}");

        _paths.Clear();
        _paths.AddRange(elements);
        _currentPath = _paths.Join('/');
    }

    private void OnUploadOpen() => _showUpload = true;
    private async Task OnUploadClose()
    {
        _showUpload = false;
        await _fileExplorer.RefreshAsync();
    }

    private void OnSearch(string? searchString)
    {
        searchString = searchString.ToNullIfEmpty();
        if (_searchString == searchString) return;

        _searchString = searchString;
    }

    private async Task OnDelete()
    {
        _showDeleteQuestion = true;

        var line = _selectedItems.Select(x => x.Path);
        _descriptions = new[] { $"Do you want to delete?" }.Concat(line).ToArray();
    }

    private async Task DeleteItem()
    {
        _showDeleteQuestion = false;
        _selectedItems.NotNull();

        foreach (var item in _selectedItems)
        {
            var fileResult = await _sharedFileStore.Delete(item.Path);
            if (fileResult.IsError())
            {
                _snackbar.Add($"Can not delete {item.Path}", Severity.Error);
                continue;
            }

            _snackbar.Add($"Deleted {item.Path}", Severity.Info);
        }

        await _fileExplorer.RefreshAsync();
    }


    private bool DisableOpenInBrowser()
    {
        if (_selectedItems.Count != 1) return true;

        var item = _selectedItems.First();
        var fileName = StorePathTool.GetFileName(item.Path);
        var ext = StorePathTool.GetFileExtension(fileName);

        if (ext.EqualsIgnoreCase(".pdf")) return false;
        return true;
    }

    private async Task OpenInBrowser()
    {
        if (DisableOpenInBrowser() == true) return;

        await DownloadItem(_selectedItems.First(), openInBrowser: true);
    }

    private async Task OnDownload()
    {
        if (_selectedItems.Count == 0) return;

        foreach (var item in _selectedItems)
        {
            await DownloadItem(item);
        }
    }

    private async Task DownloadItem(StorePathDetail item, bool openInBrowser = false)
    {
        item.NotNull().Path.NotEmpty();

        var fileResult = await _sharedFileStore.Get(item.Path);

        if (fileResult.IsError())
        {
            _snackbar.Add($"Can not find {item.Path}", Severity.Error);
            return;
        }

        byte[] fileData = fileResult.Return().Data.ToArray();
        using var fileStream = new MemoryStream(fileData);
        using var streamRef = new DotNetStreamReference(stream: fileStream);

        string jsFunction = openInBrowser ? "openFileInBrowser" : "downloadFileFromStream";
        await JSRuntime.InvokeVoidAsync(jsFunction, item.Path, streamRef);
    }
}