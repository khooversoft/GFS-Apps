@using GFSWeb.Components.Controls.Toolbar
@using MudBlazor.Utilities

<MudStack Spacing="2">

    @if (_reorder)
    {
        <ActivitiesReorder Activities="@EditContext.Activities" OnUpdate="@OnUpdateReorder" OnCancel="@OnCancelReorder" />
    }
    else
    {
        <Toolbar>
            <ToolbarButton Variant="@ToolbarVariant.Add" OnClick="OnAdd" Disabled="@_reorder" />
            <ToolbarButton Variant="@ToolbarVariant.Reorder" OnClick="@(() => _reorder = true)" Disabled="@_reorder" />
            <ToolbarButton Variant="@ToolbarVariant.Delete" OnClick="@(() => _deleteAsk = true)" Disabled="@(_selectedActivities.Count == 0 || _reorder)" />
            <ToolbarSpacer />
            <ToolbarSwitch Label="Select" @bind-Value="_multiSelect" Disabled="@_reorder" />
            <ToolbarButton Variant="@ToolbarVariant.AllCollapse" OnClick="@OnAllCollapse" Show="@(_expandedStates.Count > 0)" Disabled="@_reorder" />
            <ToolbarSearch OnClick="OnSearch" Disabled="@_reorder" />
        </Toolbar>

        <MudDataGrid T="IPackageActivity"
                     @ref="_grid"
                     Items="@EditContext.Activities"
                     Dense="true"
                     Hover="true"
                     Elevation="0"
                     SelectedItemsChanged="@SelectedItemsChanged"
                     SortMode="SortMode.Multiple"
                     ColumnResizeMode="ResizeMode.Column"
                     MultiSelection="@_multiSelect"
                     RowStyleFunc="@GetRowStyle"
                     QuickFilter="@QuickFilter"
                     HierarchyVisibilityToggled="OnExpand">

            <Columns>
                @if (_multiSelect)
                {
                    <SelectColumn T="IPackageActivity" />
                }
                <HierarchyColumn T="IPackageActivity" />
                <PropertyColumn Property="x => x.Id" Title="Id" Sortable="true" HeaderStyle="width: 1%; white-space: nowrap;" CellStyle="width: 1%; white-space: nowrap;" />
                <PropertyColumn Property="x => x.Type" Title="Type" Sortable="true" HeaderStyle="width: 1%; white-space: nowrap;" CellStyle="width: 1%; white-space: nowrap;" />
                <PropertyColumn Property="x => x.Description" Title="Description" Sortable="true" />
                <TemplateColumn HeaderStyle="width: 1%; white-space: nowrap" CellStyle="padding: 0; line-height: 0;">
                    <CellTemplate>
                        <MudMenu Icon="@Icons.Material.Outlined.MoreHoriz"
                                 AriaLabel="Open user menu"
                                 Dense="true"
                                 Variant="Variant.Text"
                                 Style="max-height: 24px; display: flex; align-items: center;">

                            <MudMenuItem Label="Delete" OnClick="@(() => _deleteAsk = true)" />

                            <MudMenu Label="Move To">
                                @if (IndexOfSelectedItem(context.Item) > 0)
                                {
                                    int currentIndex = IndexOfSelectedItem(context.Item);
                                    <MudMenuItem Label="Top" OnClick="@(() => Move(context.Item, 0))" />
                                    <MudMenuItem Label="Move Up" OnClick="@(() => Move(context.Item, currentIndex - 1))" />
                                }
                                @if (IndexOfSelectedItem(context.Item) < EditContext.Activities.Count - 1)
                                {
                                    int currentIndex = IndexOfSelectedItem(context.Item);
                                    <MudMenuItem Label="Move Down" OnClick="@(() => Move(context.Item, currentIndex + 1))" />
                                    <MudMenuItem Label="Bottom" OnClick="@(() => Move(context.Item, -1))" />
                                }
                            </MudMenu>
                        </MudMenu>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <ChildRowContent>
                @switch (context.Item)
                {
                    case SapQueryActivity sapQuery:
                        <MudStack Spacing="2">
                            <SapQueryMappingsBlock Activity="@sapQuery" OnUpdate="OnUpdate" />
                            <SapQueryBlock Activity="@sapQuery" OnUpdate="OnUpdate" ExpandState="@_expanded" />
                        </MudStack>
                        break;

                    case SqlCommandActivity sqlCommand:
                        <SqlCommandBlock Activity="@sqlCommand" OnUpdate="OnUpdate" />
                        break;
                }
            </ChildRowContent>
        </MudDataGrid>
    }
</MudStack>

<AddActivityDrawer Open="@_addOpen" OnSelect="@OnSelect" OnClose="@(() => _addOpen = false)" />

<Drawer Show="_deleteAsk" OnClose="@(() => _deleteAsk = false)">
    <DrawerHeader Title="Delete Activity">
        <MudText Typo="Typo.body1">Are you sure you want to delete these activities?</MudText>
    </DrawerHeader>

    <DrawerContainer OnYes=DeleteOnYes OnNo="@(() => _deleteAsk = false)">
        <MudStack Spacing=2>
            @foreach (var item in _selectedActivities)
            {
                <MudText Typo="Typo.body1" Class="mx-4">@($"{item.Id} - {item.Description}")</MudText>
            }
        </MudStack>
    </DrawerContainer>
</Drawer>

@code {
    @inject ActivitySelect _activitySelect;

    [Parameter] public EventCallback OnUpdate { get; set; }
    [CascadingParameter] public EditPackageContext EditContext { get; set; } = null!;

    private MudDataGrid<IPackageActivity>? _grid;
    private bool _expanded = false;
    private bool _addOpen = false;
    private bool _reorder = false;
    private bool _multiSelect = false;
    private string? _searchString;
    private HashSet<IPackageActivity> _selectedActivities = [];
    private bool _deleteAsk = false;

    private int IndexOfSelectedItem(IPackageActivity activity) => EditContext.Activities.IndexOf(x => x.Id == activity.Id);
    private void OnAdd() => _addOpen = true;
    private void InternalOnExpand(bool state) { _expanded = state; }
    private HashSet<string> _expandedStates = new();

    private void SelectedItemsChanged(HashSet<IPackageActivity> activities) => _selectedActivities = activities;

    private async Task OnAllCollapse()
    {
        if (_grid is not null) await _grid.CollapseAllHierarchy();
    }

    private void Move(IPackageActivity activity, int newIndex)
    {
        newIndex.Assert(x => x >= 0 || x == -1, "New index must be greater than or equal to 0 or -1");

        if (newIndex < 0) newIndex = EditContext.Activities.Count - 1;
        var currentIndex = EditContext.Activities.IndexOf(x => x.Id == activity.Id);
        if (currentIndex < 0 || currentIndex == newIndex) return;

        EditContext.Activities.RemoveAt(currentIndex);
        EditContext.Activities.Insert(newIndex, activity);
        _expandedStates.Clear();
    }

    private async Task DeleteOnYes()
    {
        _deleteAsk = false;
        if (_selectedActivities.Count == 0) return;

        foreach (var item in _selectedActivities)
        {
            EditContext.Activities.Remove(item);
        }

        _selectedActivities.Clear();
        await OnUpdate.InvokeAsync();
    }

    private void OnSearch(string? searchString)
    {
        searchString = searchString.ToNullIfEmpty();
        if (_searchString == searchString) return;

        _searchString = searchString;
    }

    private string GetTitle(IPackageActivity activity) => activity switch
    {
        SapQueryActivity a => a.Description,
        SqlCommandActivity a => a.Description,
        _ => throw new InvalidOperationException("Unknown activity type")
    };

    private bool QuickFilter(IPackageActivity item) => _searchString switch
    {
        null => true,
        var s => item.Search(s),
    };

    private async Task OnSelect(IReadOnlyList<ActivityInfoRecord> activities)
    {
        _addOpen = false;

        foreach (var activity in activities)
        {
            var packageActivity = _activitySelect.CreateActivity(activity);
            EditContext.Activities.Add(packageActivity);
        }

        StateHasChanged();
    }

    private void OnUpdateReorder(IReadOnlyList<IPackageActivity> activities)
    {
        EditContext.Activities = activities.ToList();
        _reorder = false;
        _expandedStates.Clear();
    }

    private void OnCancelReorder()
    {
        _reorder = false;
        _expandedStates.Clear();
    }

    private void OnExpand(DataGridHierarchyVisibilityToggledEventArgs<IPackageActivity> args)
    {
        if (args.Expanded)
            _expandedStates.Add(args.Item.Id);
        else
            _expandedStates.Remove(args.Item.Id);
    }

    private string GetRowStyle(IPackageActivity item, int index) => _expandedStates.Contains(item.Id) switch
    {
        // true when state => "background-color: var(--mud-palette-primary);",
        // true when state => "background-color: var(--mud-palette-gray-light);",
        true => "background-color: var(--mud-palette-lines-inputs);",

        _ => _selectedActivities.Any(x => x.Id == item.Id) switch
        {
            true => AppConstants.SelectRowStyle, // "background-color: var(--mud-palette-gray-default);",
            _ => String.Empty,
        },
    };
}
