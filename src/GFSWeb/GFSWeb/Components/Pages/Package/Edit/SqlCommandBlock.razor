@using GFSWeb.Components.Controls.Toolbar
<MudStack Spacing="2">
    @* <BlockToolbar2 Items="@_toolbarItems" /> *@
    <Toolbar>
        <ToolbarSpacer />
        <ToolbarButton Variant="@ToolbarVariant.Edit" OnClick="OnEdit" />
        <ToolbarButton Variant="@ToolbarVariant.Linked" OnClick="OnLinked" Show="@(_linked != null)" />
        <ToolbarButton Variant="@ToolbarVariant.Link" OnClick="OnLink" Show="@(_linked == null)" />
    </Toolbar>

    <MudField Label="SQL Command" Variant="Variant.Outlined" Style="padding:10px;">
        <MudText Style="flex:1; font-family:'Consolas','Courier New',monospace; white-space:pre-wrap; word-break:break-all;">
            @Activity.SqlCommand
        </MudText>
    </MudField>
</MudStack>

<SqlCommandEditorDrawer @bind-Open="_editorOpen"
                        SqlCommand="@Activity.SqlCommand"
                        OnSaved="OnCommandSaved"
                        OnCancelled="@(() => _editorOpen = false)" />

<CommandLinkDrawer Open="@_commandLinkOpen"
                   CommandId="@_linked?.CommandId"
                   Description="@_linked?.Description"
                   OnClose="@(() => _commandLinkOpen = false)" />

<LinkToCommandDrawer Open="@_linkToOpen" OnSelect="OnSelect" OnClose="@(() => _linkToOpen = false)" />

@code {
    @inject GFSAdminStore _store;
    [Parameter] public SqlCommandActivity Activity { get; set; } = null!;
    [Parameter] public EventCallback OnUpdate { get; set; }
    [Parameter] public EventCallback<string> OnMove { get; set; }
    [Parameter] public bool ExpandState { get; set; }
    // [Parameter] public PossibleMove PossibleMove { get; set; }
    [Parameter] public string? MoveValue { get; set; }

    private bool _editorOpen = false;
    private bool _commandLinkOpen = false;
    private bool _linkToOpen = false;
    private bool _expanded = true;
    private CommandRecord? _linked;
    // private IToolbarElement[] _toolbarItems = [];

    protected override async Task OnParametersSetAsync()
    {
        await LoadLink();
        SetupToolbar();
    }

    private void SetupToolbar()
    {
        // _toolbarItems = [
        //     new ToolbarSpacer(),
        //     ToolbarButtonTool.Edit.Create(this, OnEdit),
        //     ToolbarButtonTool.Linked.Create(this, OnLinked, show: _linked != null),
        //     ToolbarButtonTool.Link.Create(this, OnLink, show: _linked == null),
        // ];
    }

    private async Task LoadLink()
    {
        _linked = null;

        var commandOption = await _store.Command.GetByHash(Activity.Hash);
        if (commandOption.IsError()) return;

        _linked = commandOption.Return();
    }

    private string GetTItle() => _linked switch
    {
        null => Activity.Description,
        var v => $"{v.Description} -> {Activity.Description}",
    };

    private void OnEdit() => _editorOpen = true;

    private void OnLinked() => _commandLinkOpen = true;
    private void OnLink() => _linkToOpen = true;

    private async Task OnSelect(ActivityInfoRecord command)
    {
        var commandOption = await _store.Command.Get(command.Id);
        if (commandOption.IsError()) return;

        _linked = commandOption.Return();
        Activity.Description = Activity.Description.ToNullIfEmpty() ?? _linked.Description;
        Activity.SqlCommand = _linked.Data;
        Activity.Hash = Activity.GetCommandHash();

        _linkToOpen = false;
        await LoadLink();
        SetupToolbar();
    }

    private async Task OnCommandSaved(string value)
    {
        Activity.SqlCommand = value;
        Activity.Hash = Activity.GetCommandHash();
        await LoadLink();

        _editorOpen = false;
        await OnUpdate.InvokeAsync();
    }

    private void OnBlockExpand(bool expanded)
    {
        _expanded = expanded;
        StateHasChanged();
    }
}
