@page "/package/{packageId}"
@using GFSWeb.Components.Controls.Toolbar

<MudStack Spacing="2">
    <ReturnUrlButton ReturnUrl=@returnUrl />

    @if (!_initialized)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Rounded="true" Size="Size.Medium" Value="100" Style="margin:20px" />
    }
    else
    {
        <BlockHeader Title="Package" SubTitle="@_currentRecord.NotNull().Description" />

        <Toolbar Elevation="2">
            <ToolbarButton Variant="ToolbarVariant.Save" OnClick="@OnSave" />
            <ToolbarButton Variant="ToolbarVariant.Cancel" OnClick="@OnCancel" />
        </Toolbar>

        <CascadingValue Value="_editPackageContext">

            <NavTabs>
                <NavTabPanel Text="Properties" Icon="@Icons.Material.Outlined.GridOn">
                    <MudGrid Spacing="2" Style="margin:0; width:100%; box-sizing:border-box; padding:10px 12px 8px 8px;">
                        <MudItem xs="6" Class="pr-2">
                            <MudTextField T="string"
                                          Label="Description"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          Immediate="true"
                                          @bind-Value="@_description"
                                          @bind-Value:after="OnEditorChanged" />
                            <MudCheckBox @bind-Value="@_disabled">Disabled</MudCheckBox>
                        </MudItem>
                    </MudGrid>

                    @foreach (var item in _sections)
                    {
                        <EditProperties Title="@item.Title" Elements="GetSection(item.SectionId)" DisableTableId="item.DisableTableId" OnUpdate="OnUpdate" />
                    }
                </NavTabPanel>

                <NavTabPanel Text="Pipeline" Icon="@Icons.Material.Outlined.FactCheck">
                    <PipelineActivites />
                </NavTabPanel>

                <NavTabPanel Text="Access" Icon="@Icons.Material.Outlined.Shield">
                    <PackageAccess PackageId="@PackageId" />
                </NavTabPanel>

            </NavTabs>

        </CascadingValue>
    }
</MudStack>

@code {
    @inject NavigationManager _nav;
    @inject GFSAdminStore _store;
    [Parameter] public string PackageId { get; set; } = null!;
    [Parameter, SupplyParameterFromQuery] public string returnUrl { get; set; } = null!;

    private bool _initialized = false;
    private bool _navMenuCollapsed;
    private EditPackageContext _editPackageContext = null!;
    private MudTabs _tabs = null!;
    private ReportPackageRow? _currentRecord;
    private PipelinePackageRecord? _pipelinePackageRecord;
    private bool _disabled;
    private EditProperty[] _sections = [];

    private record EditProperty(SectionId SectionId, string Title, bool DisableTableId);
    private string? _description;

    protected override void OnInitialized()
    {
        _sections = [
            new EditProperty(SectionId.Parameters, SectionId.Parameters.GetTitle(), false),
            new EditProperty(SectionId.ReconExcel, SectionId.ReconExcel.GetTitle(), true),
            new EditProperty(SectionId.Pivot, SectionId.Pivot.GetTitle(), true),
            new EditProperty(SectionId.Je, SectionId.Je.GetTitle(), true),
            new EditProperty(SectionId.Data2Excel, SectionId.Data2Excel.GetTitle(), true),
        ];
    }

    private void ToggleNavMenu() => _navMenuCollapsed = !_navMenuCollapsed;

    private string GetNavText(string text) => _navMenuCollapsed ? string.Empty : text;

    private string GetNavContainerStyle() => _navMenuCollapsed
        ? "display:flex; flex:0 0 auto; max-width:none;"
        : string.Empty;

    private string GetNavPaperClass() => _navMenuCollapsed ? string.Empty : "pa-2";

    private string GetNavPaperStyle() => _navMenuCollapsed
        ? "width:60px"
        : string.Empty;

    private string GetNavStackClass() => _navMenuCollapsed ? "align-center" : string.Empty;

    private string GetNavMenuClass() => _navMenuCollapsed ? "d-flex flex-column align-center" : string.Empty;

    private string GetNavLinkClass() => _navMenuCollapsed ? "d-flex justify-center" : string.Empty;

    private Task OnProperty() => ActivatePanel(0);
    private Task OnPipeline() => ActivatePanel(2);
    private Task OnAccess() => ActivatePanel(3);

    private async Task ActivatePanel(int panelIndex)
    {
        if (_tabs is not null)
        {
            await _tabs.ActivatePanelAsync(panelIndex);
        }
    }

    private List<MiscTablesRecord> GetSection(SectionId sectionId)
    {
        if (_pipelinePackageRecord is null) return new List<MiscTablesRecord>();
        return _pipelinePackageRecord.GetSection(sectionId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadPackage();
            StateHasChanged();
        }
    }

    private void OnExapendAll() { }
    private void OnCollapseAll() { }

    private async Task LoadPackage()
    {
        _currentRecord = (await _store.Package.Get(PackageId)).BeOk().Return();
        _pipelinePackageRecord = _currentRecord.Unpack();
        _description = _currentRecord.Description;
        _disabled = _currentRecord.Disabled;

        _editPackageContext = _pipelinePackageRecord.ConvertTo();
        _initialized = true;
    }

    private void OnSave() => NavHelper.ElimPackages.NavigateTo(_nav, returnUrl: _nav.Uri);
    private void OnCancel() => _nav.NavigateTo(returnUrl);

    private async Task OnUpdate()
    {
        await Task.CompletedTask;
    }

    private void OnEditorChanged()
    {
    }
}