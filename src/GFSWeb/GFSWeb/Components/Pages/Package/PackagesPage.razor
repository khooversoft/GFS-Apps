@page "/packages"
@using GFSWeb.Components.Controls.Toolbar

@if (!_initialized)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Rounded="true" Size="Size.Medium" Value="100" Style="margin:20px" />
}
else
{
    <MudStack Spacing="2">
        <ReturnUrlButton ReturnUrl=@returnUrl />
        <BlockHeader Title="Packages" />

        <Toolbar>
            <ToolbarButton Variant="ToolbarVariant.Add" OnClick="OnAdd" />
            <ToolbarButton Variant="ToolbarVariant.Edit" OnClick="OnEdit" Disabled="@_editDisabled" />
            <ToolbarButton Variant="ToolbarVariant.Delete" OnClick="OnDelete" Disabled="@_deleteDisabled" />
            <ToolbarSpacer />
            <ToolbarSwitch Label="Select" @bind-Value="_multiSelect" />
            <ToolbarSearch OnClick="OnSearch" Disabled="@_searchDisabled" />
        </Toolbar>

        <MudExpansionPanels MultiExpansion="true" @ref="@_expansionPanels">
            <MudExpansionPanel Text="Favorites" Expanded="true">
                <PackageList List="@_favorites" MultiSelect="@_multiSelect" SearchText="@_searchString" SelectedItemsChanged="@SelectedItemsChanged" OnUpdate="@Load" />
            </MudExpansionPanel>
            <MudExpansionPanel Text="All Packages" Expanded="true">
                <PackageList List="@_list" MultiSelect="@_multiSelect" SearchText="@_searchString" SelectedItemsChanged="@SelectedItemsChanged" OnUpdate="@Load" />
            </MudExpansionPanel>
        </MudExpansionPanels>
    </MudStack>

    <Question Show=_deleteAsk Title="Delete Group" Descriptions=@_deleteDescriptions OnYes=DeleteOnYes OnNo=DeleteCancel OnClose=DeleteCancel />
}

@code {
    @inject GFSAdminStore _store;
    @inject NavigationManager _nav;
    @inject ISnackbar _snackbar;
    [Parameter, SupplyParameterFromQuery] public string returnUrl { get; set; } = null!;

    private HashSet<ReportPackageRow> _selectedItems = new();
    private IReadOnlyList<ReportPackageRow> _list = null!;
    private IReadOnlyList<ReportPackageRow> _favorites = null!;
    private bool _initialized = false;
    private bool _searchDisabled = true;
    private bool _editDisabled = true;
    private bool _deleteDisabled = true;
    private bool _multiSelect = false;
    private string? _searchString;
    private bool _deleteAsk = false;
    private IReadOnlyList<string> _deleteDescriptions = Array.Empty<string>();
    private MudExpansionPanels _expansionPanels = null!;

    protected override async Task OnParametersSetAsync() => await Load();

    private async Task SetFavorite(ReportPackageRow row, bool value)
    {
        var result = await _store.UserUsage.UpsertUsage(row.PackageId, value);
        if (result.IsError()) _snackbar.Add(result.Error ?? "Failed", Severity.Error);

        await Load();
    }

    private async Task Load()
    {
        _list = await _store.Package.GetAll();
        _favorites = _list.Where(x => x.IsFavorite).ToList();
        _searchDisabled = _list.Count == 0;
        _initialized = true;
    }

    private async Task SelectedItemsChanged(HashSet<ReportPackageRow> items)
    {
        _selectedItems = items;

        (_editDisabled, _deleteDisabled) = items.Count switch
        {
            0 => (true, true),
            1 => (false, false),
            _ => (true, false)
        };
    }

    private string GetRowStyle(ReportPackageRow item, int index)
    {
        var result = _selectedItems.Any(x => x.PackageId == item.PackageId);
        return result ? "background-color: var(--mud-palette-action-default-hover);" : string.Empty;
    }

    private void OnAdd() => NavHelper.Command.NavigateTo(_nav, "new-record", _nav.Uri);

    private void OnEdit()
    {
        if (_selectedItems.Count != 1) return;
        NavHelper.Command.NavigateTo(_nav, _selectedItems.First().PackageId, _nav.Uri);
    }

    private void OnSearch(string? searchString)
    {
        searchString = searchString.ToNullIfEmpty();
        if (_searchString == searchString) return;

        _searchString = searchString;
        _expansionPanels.ExpandAllAsync();
    }

    private bool QuickFilter(ReportPackageRow item)
    {
        if (_searchString is null) return true;

        return item.PackageId.Contains(_searchString, StringComparison.OrdinalIgnoreCase)
            || (item.Description?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private void OnDelete()
    {
        if (_selectedItems.Count == 0) return;

        _deleteDescriptions = _selectedItems
            .Select((x, i) => $"{i}) {x.Description}")
            .Prepend("Are you sure you want to delete command?")
            .ToArray();

        _deleteAsk = true;
    }

    private async Task DeleteOnYes()
    {
        _deleteAsk = false;
        if (_selectedItems.Count == 0) return;

        foreach (var item in _selectedItems)
        {
            var deleteOption = await _store.Command.Delete(item.PackageId, item.Description);
            if (deleteOption.IsError()) return;
        }

        await Load();
    }

    public void DeleteCancel() => _deleteAsk = false;
}
